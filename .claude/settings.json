{
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(C:/Projects/facet-crm/**)",
      "Write(C:/Projects/facet-crm/**)"
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "55",
    "CLAUDE_CODE_EFFORT_LEVEL": "xhigh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-writes.mjs",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-bash.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
