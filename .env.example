# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- PostgreSQL -----------------------------------------------------------
# These create the database inside the db container on first run. Changing
# them after the volume exists has no effect — remove the volume to reset.
POSTGRES_USER=kladra
POSTGRES_PASSWORD=change_me_before_real_users
POSTGRES_DB=kladra

# Used by host-side tooling: `npm run dev`, drizzle-kit and every db:* script.
# Host port is 5433 (FACET holds 5432 on the same PC). The app container does
# NOT use this value — docker-compose.yml points the container at host "db".
DATABASE_URL=postgresql://kladra:change_me_before_real_users@localhost:5433/kladra

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3100
AUTH_TRUST_HOST=true

# The public address of the site, set ONLY in production. docker-compose.yml
# overrides AUTH_URL from this. Use https — that is what makes Auth.js mark
# the session cookie Secure. Forgetting it is silent: login still works and
# the token crosses the tunnel unprotected.
# PUBLIC_URL=https://kladra.example.com

# --- Backups --------------------------------------------------------------
# Where `npm run backup` writes its dumps. Defaults to ./backups (git-ignored).
# On the office PC, point this at the folder the NAS already sweeps.
# A dump holds every row and every password hash — protect the folder like
# the database.
# BACKUP_DIR=

# --- Demo seed ------------------------------------------------------------
# Password given to every demo account by `npm run seed:demo`.
SEED_PASSWORD=kladra2026
