 at Malham is coordinator knowledge, NOT enforced.","payment_method_note":"pg enum 'payment_method' src/db/schema.ts:264-271, recorded on the DISPATCH not the quotation (S70/S71); nullable, required only at approval via CHECK dispatches_payment_method (S73). handled_by_finance = credit / تساهيل / company contract settled in SMAC. payment_note text beside it. Replaced free text where reps typed '50% advance'. There is NO payment_terms lookup; 'payment_terms' exists only as a report_signal enum value (schema.ts:432).","roles_seed":{"file":"scripts/seed/roles.ts:49-169, upsert on roles_name_en_key via scripts/seed-roles.ts:14-23","flags":["canAssign","canShare","canExport","canSetTargets","canSetCompanyTarget","seesAllReps","canDispatch","canApproveQuotation","canImpersonate","canManageUsers","canSetCreditSplit","canApproveDelete","canResolveDuplicate"],"rows":[{"en":"Super Admin","ar":"مدير النظام","true_flags":"ALL 13"},{"en":"Executive","ar":"تنفيذي","true_flags":["canExport","canSetTargets","seesAllReps","canManageUsers","canSetCreditSplit","canApproveDelete","canResolveDuplicate"]},{"en":"Sales Manager","ar":"مدير المبيعات","true_flags":["canAssign","canShare","canSetTargets","seesAllReps","canManageUsers","canSetCreditSplit","canApproveDelete","canResolveDuplicate"]},{"en":"Sales Coordinator","ar":"منسق المبيعات","true_flags":["canDispatch","canApproveQuotation","canSetCreditSplit"]},{"en":"Marketing","ar":"التسويق","true_flags":["canAssign"]},{"en":"Desk Rep","ar":"مندوب مكتبي","true_flags":["canAssign"]},{"en":"Sales Rep","ar":"مندوب مبيعات","true_flags":[]}],"notes":"Role names exist ONLY in the seed; authz reads flags never names. canSetCompanyTarget = Super Admin alone (S136). Desk Rep flag-identical to Marketing today, kept separate as a separate job (12 §2). SUPER_ADMIN_NAME_EN = ROLE_SEED[0].nameEn (roles.ts:173)."},"notification_types_seed":{"file":"scripts/seed/notification-types.ts:49-152, keys from NOTIFICATION_TYPES in src/lib/enums.ts; insert-if-absent never overwrite (scripts/seed-notification-types.ts)","rows":[{"key":"record.assigned (NOTIFICATION_TYPES.recordAssigned)","en":"Assigned to you","ar":"أُسند إليك"},{"key":"record.handed_over","en":"Work handed over to you","ar":"تم تسليم عمل إليك"},{"key":"share.granted","en":"Shared with you","ar":"تمت مشاركته معك","note":"only seeded type with no live producer"},{"key":"mention.received","en":"Mentioned you","ar":"أشار إليك"},{"key":"decision.ended_work","en":"A decision ended your work","ar":"قرار أنهى عملك"},{"key":"credit.granted","en":"Credit shared with you","ar":"تمت مشاركة رصيد معك"}],"note":"followup.digest removed (S91: the list IS the notification). tier/is_persistent/channel columns dropped."},"settings_seed":{"file":"scripts/seed-settings.ts:44-54 with keys/defaults in src/lib/settings.ts; insert-if-absent, NEVER overwrite (manager-editable data)","rows":[{"key":"followup.quiet_days.qualified","default":30,"unit":"calendar days"},{"key":"followup.quiet_days.unqualified","default":60,"unit":"calendar days"},{"key":"followup.quotation_no_response.working_days","default":5,"unit":"working days (Fri+Sat skipped)"},{"key":"followup.quotation_returned.working_days","default":5,"unit":"working days"},{"key":"followup.catalogue_no_response.working_days","default":10,"unit":"working days"},{"key":"followup.project_stage_unchanged.days","default":21,"unit":"calendar days"},{"key":"attention.silent_days","default":14,"unit":"calendar days (founder said 2-3 weeks, seeded at near end)"}],"note":"settings.value is jsonb; reader getPositiveIntSetting treats non-positive-int as absent and uses fallback (settings.ts:115-123). No edit screen exists."},"other_pg_enums":{"record_type":["company","contact","project","quotation_thread","dispatch"],"smac_reference_verification":["unverified","verified"],"company_rep_origin":["self_registered","assigned"],"non_working_kind":["public_holiday","leave"],"dormancy_outcome":["reincluded","reassigned","archived"],"project_end_state":["lost"],"quotation_thread_end_state":["accepted","rejected","cancelled"],"quotation_version_status":["requested","issued","superseded"],"quotation_version_origin":["initial_request","rep_change_request","coordinator_direct_edit"],"dispatch_status":["draft","submitted","approved","refused","cancelled"],"duplicate_flag_source":["entry_match","manual"],"duplicate_flag_status":["open","resolved"],"duplicate_resolution":["who_continues","shared","false_flag"],"rep_report_entry_type":["interaction","field_note"],"rep_report_channel":["visit","call","whatsapp","email","meeting"],"rep_report_outcome":["introduced","catalogue_sent","samples_sent","documents_sent","technical_submitting","discussed_pricing","no_answer","not_interested","on_hold","other"],"field_note_category":["market_research","scouting","exhibition","training","internal"],"report_signal":["price_too_high","competitor_cheaper","colour_unavailable","lead_time_too_long","quality_concern","payment_terms","specification_unavailable","project_delayed","other"],"signals_with_reference":["competitor_cheaper (which competitor)","colour_unavailable (which colour code)","specification_unavailable (which class or fire rating)","other (free text)"],"source":"src/db/schema.ts:80-450 and src/lib/enums.ts (mirrors, assertSameValues keeps them in step)"},"enum_labels_ar":{"reportChannel":{"visit":"زيارة","call":"اتصال","whatsapp":"واتساب","email":"بريد إلكتروني","meeting":"اجتماع"},"reportOutcome":{"introduced":"تعريف بالشركة","catalogue_sent":"إرسال الكتالوج","samples_sent":"إرسال عينات","documents_sent":"إرسال مستندات","technical_submitting":"تقديم فني","discussed_pricing":"مناقشة الأسعار","no_answer":"لا يوجد رد","not_interested":"غير مهتم","on_hold":"مؤجل","other":"أخرى"},"fieldNoteCategory":{"market_research":"بحث السوق","scouting":"استكشاف","exhibition":"معرض","training":"تدريب","internal":"عمل داخلي"},"reportSignal":{"price_too_high":"السعر مرتفع","competitor_cheaper":"منافس أرخص","colour_unavailable":"اللون أو المنتج غير متوفر","lead_time_too_long":"مدة التوريد طويلة","quality_concern":"ملاحظة على الجودة","payment_terms":"شروط الدفع","specification_unavailable":"مواصفة لا نوفرها","project_delayed":"المشروع مؤجل","other":"أخرى"},"dormancyOutcome":{"reincluded":"أُعيد إدراجها","reassigned":"أُعيد إسنادها","archived":"مؤرشفة"},"dispatchStatus":{"draft":"مسودة","submitted":"بانتظار الاعتماد","approved":"معتمد","refused":"مرفوض","cancelled":"ملغى"},"quotationVersionStatus":{"requested":"مطلوب","issued":"صادر","superseded":"مستبدل"},"quotationVersionOrigin":{"initial_request":"الطلب الأول","rep_change_request":"طلب تعديل من المندوب","coordinator_direct_edit":"تعديل من منسق المبيعات"},"source":"messages/ar.json enums.*; English in messages/en.json (reportSignal.colour_unavailable EN = 'Colour or product not available', specification_unavailable EN = 'Specification we do not offer')"},"colours":"NO colour lookup at all (17 §2): colour is typed free text on quotation_lines.custom_colour (e.g. '168' or a RAL/Pantone). Colour lookup table dropped in slice 6 (26 §2). scripts/seed/products.ts:8-11.","product_specifications":"Table exists (schema.ts:1449-1490) keyed UNIQUE on supplier+class+fire_rating+thickness with bilingual description/manufacturing_standards/alloy/layers/core/protective_film/colour_availability text columns. NOT seeded anywhere — no document lists the real combinations (12 §8: which class/fire-rating combos are real varies by factory; no DB constraint ties class to fire rating).","standard_dimensions":"No seeded standard width/length values found anywhere in src/ or scripts/ (grep for 1220/1250/2440/STANDARD_WIDTH etc. returned nothing relevant). Schema comment (schema.ts:1495-1497) says width/length are editable, 'standard values are offered as defaults' but none are coded.","dropped_supplier_codes":"08 B1 also had suppliers G, G1, Y — dropped per founder ('we dont need them anymore'), never seeded. scripts/seed/products.ts:21-23.","legacy_vocabularies_pre_facet":{"source":"C:/dev/facet-crm/legacy/schema.sql (the app before FACET)","branches.region":["Central","West","East","North","South"],"reps.role":["rep","manager","sales_coordinator","marketing"],"reps.status":["active","inactive","pending"],"companies.company_type":["Factory","Advertising","Real Estate","Owner","Consultant","Contractor","Station Management","Workshop","Other"],"companies.region":["Central","West","East","North","South","Foreign"],"companies.source":["Form","Marketing","Management","Referral","Direct","Exhibition"],"companies.status":["active","inactive","blocked"],"projects.stage":["New Lead","Catalog Sent","Quotation Sent","Under Review","Won","In Production","Delivered","Lost"],"activities.interaction_type":["Visit","Call","WhatsApp","Email","Meeting","Site Visit"],"activities.submission_status":["on_time","late","missing"],"quotations.product_type":["Normal ACP","FR B1 ACP","FR A2 ACP","A2G2 ACP","Other"],"quotations.finish":["Solid Color","Wood Finish","Custom"],"quotations.status":["pending","submitted","won","lost","expired","cancelled"],"notifications.type":["duplicate_alert","pending_approval","assignment","project_stale","quotation_expiry","follow_up_due","lead_submitted","missing_submission","system"],"absences.absence_type":["sick","annual_leave","eid_vacation","other"],"note":"FACET deliberately replaced these: legacy stage dropdown conflated unordered activities with the ordered quotation chain (25 §1); 'Foreign' region became a countries table; project_type became supplier/class/fire-rating/thickness attributes."},"seeding_mechanics_traps":["All lookup seeds are idempotent read-then-write keyed on natural key; NOTHING deletes — a value removed from a seed array stays in DB because history references it (12 §7). scripts/seed-lookups.ts:9-18.","Natural keys: company_categories/lead_sources/cities/product_suppliers/classes/fire_ratings/service_types keyed on name_en; thicknesses on thickness_mm value; loss_reasons on code (unique index loss_reasons_code_key); countries on code (unique index countries_code_key); roles on name_en (unique roles_name_en_key); notification_types on key. Only loss_reasons, countries, roles have unique indexes; the rest deliberately none (12 §14).","Re-run corrections: categories fix name_ar; lead_sources fix name_ar + rep_selectable; countries fix both names; cities fix name_ar + region (in place, existing companies keep region written at the time 15 §4); loss_reasons fix both names; product lookups fix name_ar; thicknesses fix is_standard; service_types fix name_ar. Settings and notification_types NEVER overwrite.","Migration 0010 (drizzle/0010_phone_and_country.sql:45) inserts Saudi Arabia ('SA','Saudi Arabia','السعودية') itself because companies.country_id is NOT NULL and needed backfill; seed finds it by code and leaves it.","SAUDI_CODE='SA' (src/lib/enums.ts:30) is the one country the app knows by name: Saudi company => city required, region derived from city; anything else => city and region both forced null, whatever the form posted (lookups.ts:163-182).","Cities are Saudi-only; no foreign cities. Grouped by 13 administrative regions in the seed file (documentation only, adminEn/adminAr NOT stored), each group maps to one of 5 region enum values. 171 rows total: Riyadh 28, Al-Qassim 14, Tabuk 7, Ha'il 11, Al-Jawf 6, Northern Borders 4, Eastern Province 26, Makkah 18, Al-Madinah 9, 'Asir 16, Jazan 15, Najran 8, Al-Bahah 9. City combobox searches both en and ar regardless of UI language (15 §5).","Lead source Marketing rep_selectable=false: only can_assign holders may pick it; re-saving an unchanged restricted value is allowed, clearing is allowed, only a CHANGE is checked (lookups.ts:290-311). Column default true.","product thickness numeric(5,2) reads back as string, so seed writes '4.00' etc. 4 mm is the only is_standard row and is omitted from the (no longer generated) product name.","Product lookups' code column dropped in migration 0027 because code WAS name_en in every row; the 'code' values in this answer are identical to name_en.","Display order: every list function in src/lib/lookups.ts orders by name_en asc (thicknesses by thickness_mm asc). NO pin/sort_order field exists on any lookup; seed-file order is not the display order. Company category seed order is the founder's order with Personal before Other and Other last, but the screen sorts alphabetically anyway.","lookupName()/pickName() fall back to name_en when name_ar is empty (lookups.ts:411-430).","Countries listed by name_en asc; only 9 rows — founder's list (Saudi + Gulf + Egypt, Jordan, Syria), NOT ~200. Adding one is a seed edit and re-run, never a migration.","Enum vs lookup rule (schema.ts:75-77): closed set fixed by a document = pg enum; anything a document says stays editable = lookup table. Enums whose code branches on identity (stock, shipment_method) must be enums because a uuid into an editable table cannot be branched on safely."]},"notes":"FILES: suppliers/classes/fire_ratings/thicknesses = C:/dev/facet-crm/scripts/seed/products.ts (lines 34-39, 42-47, 51-55, 65-73). company_categories = scripts/seed/company-categories.ts:16-28. lead_sources = scripts/seed/lead-sources.ts:23-36 (extra field repSelectable). countries = scripts/seed/countries.ts:23-33 (9 rows; plus drizzle/0010_phone_and_country.sql:45 inserts SA). cities = scripts/seed/cities.ts:35-298 (GROUPS flattened via CITY_SEED :307-313; admin region is a doc-only grouping, stored columns are name_en, name_ar, region). loss_reasons = scripts/seed/loss-reasons.ts:30-79. service_types = scripts/seed/services.ts:19-24. roles = scripts/seed/roles.ts. notification_types = scripts/seed/notification-types.ts. settings = scripts/seed-settings.ts + src/lib/settings.ts. Orchestrator scripts/seed-lookups.ts (seedLookups order: company categories, lead sources, loss reasons, countries, cities, suppliers, classes, fire ratings, thicknesses, service types) called by scripts/seed.ts (roles, lookups, settings, notifications). shipment_methods and payment_methods are pg ENUMS (src/db/schema.ts:281-285, 264-271), not seeded tables; their en/ar labels come from messages/en.json and messages/ar.json under enums.shipmentMethod.* / enums.paymentMethod.*. No payment_terms lookup exists. No sort/pin-order fields exist on any lookup table; lists are ordered by name_en asc at read time (src/lib/lookups.ts). Arabic present for every lookup row (product codes reuse the Latin token as name_ar; only 'Normal' fire rating has a real Arabic 'عادي'). src/db/ contains no seeding — only index.ts and schema.ts; the only data-seeding migration is 0010 (Saudi Arabia). Demo/fixture scripts (seed-demo.ts, dev-fixtures.ts, quotation-fixture.ts, dispatch-fixture.ts) insert users/quotationLines/dispatchLines only, no lookups."}