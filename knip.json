{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,error,not-found,loading,default}.tsx",
    "src/app/**/route.ts",
    "src/middleware.ts",
    "src/proxy.ts",
    "src/auth.ts",
    "src/i18n/request.ts",
    "src/components/team/reliance-card.tsx",
    "scripts/*.{ts,mts}",
    "tests/**/*.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    ".claude/hooks/*.mjs",
    "public/sw.js"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mts}",
    "tests/**/*.ts"
  ],
  "ignore": [
    "src/components/ui/**"
  ],
  "ignoreDependencies": [
    "@playwright/cli",
    "shadcn",
    "tw-animate-css",
    "tailwindcss",
    "playwright-core"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "types": "off",
    "exports": "warn"
  }
}
